# Relocatable: the prefix is found from where this file is installed.
prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: darpa_spill_client
Description: @PROJECT_DESCRIPTION@
URL: @PROJECT_HOMEPAGE_URL@
Version: @PROJECT_VERSION@
Libs: -L${libdir} -ldarpa_spill_client -lboost_json
Libs.private: -lyaml-cpp -lssl -lcrypto
Cflags: -I${includedir}
