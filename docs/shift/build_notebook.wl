(* ::Package:: *)

(* build_notebook.wl -- generate docs/TimestampShift.nb with evaluated outputs.

   wolframscript -file docs/shift/build_notebook.wl

   The notebook is written from this script, not edited by hand, so that every
   number and plot in it comes from a fresh evaluation of dts1.wl against the
   sample data.  It also writes docs/shift/dts1_test_vectors.json, which the
   Python tests read.  Run from any directory; paths are resolved from this
   file.  Takes a few minutes.  Prints __DONE__ when finished (wolframscript
   does not always exit by itself afterwards).
*)

$here = DirectoryName[$InputFileName];
$DTS1Dir = $here;
$out = FileNameJoin[{ParentDirectory[$here], "TimestampShift.nb"}];

cells = {};
add[c_] := AppendTo[cells, c];

title[s_] := add[Cell[s, "Title"]];
subtitle[s_] := add[Cell[s, "Subtitle"]];
sec[s_] := add[Cell[s, "Section"]];
subsec[s_] := add[Cell[s, "Subsection"]];
m[e_] := Cell[BoxData[ToBoxes[e, TraditionalForm]]];
txt[parts__] := add[Cell[TextData[{parts}], "Text"]];
item[parts__] := add[Cell[TextData[{parts}], "Item"]];
eq[e_] := add[Cell[BoxData[ToBoxes[e, TraditionalForm]], "DisplayFormula"]];
mono[s_] := StyleBox[s, FontFamily -> "Courier"];
p10[e_Integer] := Cell[BoxData[SuperscriptBox["10", If[e < 0, RowBox[{"\[Minus]", ToString[-e]}], ToString[e]]]]];
sci[mant_String, e_Integer] := Cell[BoxData[RowBox[{mant, "\[Times]",
     SuperscriptBox["10", If[e < 0, RowBox[{"\[Minus]", ToString[-e]}], ToString[e]]]}]]];
pre[s_] := add[Cell[s, "Program"]];

(* An input cell, evaluated now; its result becomes the output cell unless the
   code ends in a semicolon. *)
code[src_String] := Module[{boxes, res, t},
  boxes = UsingFrontEnd[FrontEndExecute[FrontEnd`ReparseBoxStructurePacket[src]]];
  add[Cell[BoxData[boxes], "Input"]];
  {t, res} = AbsoluteTiming[ToExpression[src]];
  Print["  [", Round[t, 0.01], " s] ", StringTake[StringReplace[src, "\n" -> " "], UpTo[70]]];
  If[res =!= Null, add[Cell[BoxData[ToBoxes[res, StandardForm]], "Output"]];
   If[FreeQ[res, Graphics | Graphics3D | Legended | Grid],
    Print["      = ", StringTake[ToString[res, InputForm], UpTo[400]]]];
   If[!FreeQ[res, Grid], Print["      p = ", Cases[res, _Real?(0 < # < 1 &), Infinity, 3]]]];
  res];

Print["building ", $out];

(* ======================================================================= *)

title["Reversible Timestamp Blurring for Spill Data"];
subtitle["The dts1 transform: specification, reference implementation and verification"];
txt["DARPA Spill Information Server, ", mono["docs/TimestampShift.nb"],
  ". Generated by ", mono["docs/shift/build_notebook.wl"], " from ",
  mono["docs/shift/dts1.wl"], "; every output below is the result of evaluating the cell above it. ",
  "Built with Mathematica ", First[StringSplit[$Version]], " on ",
  DateString[{"Year", "-", "Month", "-", "Day"}], "."];

sec["1. Purpose"];
txt["The archive records accelerator event times to one tick of the NOvA 64 MHz clock (15.625 ns). ",
  "Some uses of the data need the times blurred: each timestamp moved by a small random amount, so that ",
  "a recipient sees approximately when events happened but not exactly. The owner of the data must be able ",
  "to undo the blurring exactly, later, holding nothing but a secret token and the blurred file."];
txt["Requirements, as given:"];
item["Start from the output of ", mono["darpa-spill-dump"], " (CSV or JSON)."];
item["Shift each event's timestamp by a random offset, positive or negative."];
item["Offsets follow a chosen random variate: flat (uniform) or Gaussian."];
item["The offsets derive from an initial token or seed, generated or supplied by the user."];
item["The transform is invertible knowing only the token and the shifted data point."];
item["The user sets the amount of blur; it is small, never beyond \[PlusMinus]500 ms."];
txt["This notebook defines the transform (version ", mono["dts1"], "), gives a reference implementation, ",
  "proves and tests its invertibility, characterises the variates, and examines what the blur does and does ",
  "not hide. It is the specification the Python implementation (", mono["darpa_spillserver.shift"],
  ", command ", mono["darpa-spill-shift"], ") is tested against."];

sec["2. Setup"];
code["Get[FileNameJoin[{If[ValueQ[$DTS1Dir], $DTS1Dir, FileNameJoin[{NotebookDirectory[], \"shift\"}]], \"dts1.wl\"}]];\n$dataDir = If[ValueQ[$DTS1Dir], $DTS1Dir, FileNameJoin[{NotebookDirectory[], \"shift\"}]];"];
code["{$Ticks, $MaxOffset}"];
txt["One second is ", m[$Ticks], " ticks; the largest permitted bound, 500 ms, is ", m[$MaxOffset], " ticks. ",
  "All offsets are whole ticks, so shifted timestamps remain integers on the same clock."];

(* ======================================================================= *)
sec["3. What has to be transformed"];
txt["A dump row carries the event time in several forms. Moving ", mono["nova_time"],
  " alone would leave the true time readable from the others, so each must be considered."];
code["sample = Import[FileNameJoin[{$dataDir, \"sample_2026-10-12T0000_10min.csv\"}], \"CSV\"];\nsample = Select[sample, StringQ[#[[1]]] =!= True || !StringStartsQ[#[[1]], \"#\"] &];\nheader = First[sample];\nrows = AssociationThread[header -> #] & /@ Rest[sample];\nLength[rows]"];
code["TableForm[Values /@ rows[[;; 6]], TableHeadings -> {None, header}]"];
txt[mono["utc"], ", ", mono["gps"], ", ", mono["unix_*"], " and the other time columns are functions of ",
  mono["nova_time"], " and are simply recomputed from the shifted value. Two columns are not:"];
code["Counts[(#[\"pps_offset\"] - Mod[#[\"nova_time\"], $Ticks]) & /@ rows]"];
txt[mono["pps_offset"], " is exactly ", m[HoldForm[Mod[t, T]]],
  " on every row: the sub-second phase of the true time. Left alone it would undo any blur below one second."];
code["byKey = Association[(#[\"source\"] -> #[\"event_number\"]) -> #[\"nova_time\"] & /@ rows];\nCounts[Map[With[{p = byKey[#[\"source\"] -> #[\"event_number\"] - 1]},\n     Which[MissingQ[p], \"predecessor not in file\",\n      #[\"delta\"] == #[\"nova_time\"] - p, \"delta = t(n) - t(n-1)\", True, \"other\"]] &, rows]]"];
txt[mono["delta"], " is the gap to the previous hardware event on the same TDU, ",
  m[HoldForm[Subscript[t, n] - Subscript[t, n - 1]]], ", where ", m[n], " is ", mono["event_number"],
  ". Chained from any one known time it would give back every other. On ", mono["ppc-01"],
  " about 19% of predecessors are events the archive never stored, so ", mono["delta"],
  " cannot simply be recomputed from neighbouring rows. (Over 1,052,663 rows on 12\[Dash]13 October 2026 the ",
  "same two relations hold without exception.)"];

(* ======================================================================= *)
sec["4. The idea"];
txt["Give every hardware event its own offset, chosen by a keyed pseudorandom function of something the ",
  "transform does not change. The pair (", mono["source"], ", ", mono["event_number"],
  ") identifies a hardware event and is left untouched, so the offset ", m[Subscript[o, n]],
  " can be recomputed from the shifted row and the key, and subtracted:"];
eq[HoldForm[Subscript[t, n]^\[Prime] == Subscript[t, n] + Subscript[o, n]]];
eq[HoldForm[Subscript[t, n] == Subscript[t, n]^\[Prime] - Subscript[o, n]]];
txt["Because ", m[Subscript[o, n - 1]], " is defined whether or not event ", m[n - 1],
  " is in the file, ", mono["delta"], " and ", mono["pps_offset"], " transform as the same shift applied to both ends:"];
eq[HoldForm[Subscript[\[CapitalDelta], n]^\[Prime] == Subscript[\[CapitalDelta], n] + Subscript[o, n] - Subscript[o, n - 1]]];
eq[HoldForm[Subscript[p, n]^\[Prime] == Mod[Subscript[p, n] + Subscript[o, n], T]]];
txt["Each is a bijection with an explicit inverse, ",
  m[HoldForm[Subscript[\[CapitalDelta], n] == Subscript[\[CapitalDelta], n]^\[Prime] - Subscript[o, n] + Subscript[o, n - 1]]],
  " and ", m[HoldForm[Subscript[p, n] == Mod[Subscript[p, n]^\[Prime] - Subscript[o, n], T]]],
  " (the latter because ", m[HoldForm[0 <= Subscript[p, n] < T]], "). When event ", m[n - 1],
  " is present, ", m[HoldForm[Subscript[\[CapitalDelta], n]^\[Prime] == Subscript[t, n]^\[Prime] - Subscript[t, n - 1]^\[Prime]]],
  " exactly, so the shifted file is self-consistent. None of this depends on how the TDU defines the columns: ",
  "the inverse is algebraic."];

(* ======================================================================= *)
sec["5. Specification of dts1"];
subsec["5.1 Token"];
txt["A token carries the distribution, its parameters in ticks, and a 256-bit secret ", m[K], ":"];
pre["dts1:flat:a=A:<64 hex digits>\ndts1:gauss:sigma=S:cut=C:<64 hex digits>"];
txt["Holding the token is sufficient to invert; nothing else is needed. The part before the secret is the ",
  StyleBox["parameter string", FontSlant -> "Italic"], " ", m[P], ", which is public and is mixed into every ",
  "keyed block so that the same secret with different parameters gives unrelated offsets. Constraints: ",
  m[HoldForm[1 <= A <= 32000000]], "; ", m[HoldForm[S >= 1]], ", ", m[HoldForm[S/2 <= C <= 32000000]], "."];
txt[m[K], " is either 32 random bytes, or derived from a user seed with PBKDF2-HMAC-SHA256 (RFC 8018), salt ",
  mono["darpa-spill-shift/dts1"], ", 600,000 iterations. A seed is convenient and reproducible but only as ",
  "strong as the seed: an attacker who can guess it can invert the data."];
txt["A public ", StyleBox["fingerprint", FontSlant -> "Italic"], ", the first 64 bits of ",
  m[HoldForm[HMAC[K, "dts1 fingerprint|" <> P]]], ", is written into shifted files so that inversion with the ",
  "wrong token is detected rather than silently producing wrong times. It reveals nothing about ", m[K], "."];
code["tokF = makeToken[<|\"dist\" -> \"flat\", \"a\" -> 3200000|>, ByteArray[Normal@Hash[\"dts1 test vector\", \"SHA256\", \"ByteArray\"]]]"];
code["tokG = makeToken[<|\"dist\" -> \"gauss\", \"sigma\" -> 1280000, \"cut\" -> 3840000|>, ByteArray[Normal@Hash[\"dts1 test vector\", \"SHA256\", \"ByteArray\"]]]"];
code["{fingerprint[tokF], fingerprint[tokG]}"];
txt["These two tokens, flat \[PlusMinus]50 ms and Gaussian \[Sigma] = 20 ms cut at 3\[Sigma] = 60 ms, are used ",
  "throughout. Their secret is the SHA-256 of a public string: test tokens only."];

subsec["5.2 Keyed blocks"];
txt["For event ", m[n], " of source ", m[s], ", block ", m[j], " is"];
eq[HoldForm[Subscript[B, j] == HMAC["SHA-256", K, P <> "|" <> s <> "|" <> n <> "|" <> j]]];
txt["with ", m[n], " and ", m[j], " as signed decimal integers. HMAC-SHA256 is a pseudorandom function: ",
  "without ", m[K], " its outputs are indistinguishable from independent uniform bytes, and knowing any number of ",
  "offsets does not help predict another. Check against RFC 4231, test case 2:"];
code["StringJoin[IntegerString[Normal@hmacSHA256[StringToByteArray[\"Jefe\"], \"what do ya want for nothing?\"], 16, 2]] ==\n \"5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843\""];

subsec["5.3 Flat variate"];
txt["Read the first 16 bytes of ", m[Subscript[B, 0]], " as a big-endian integer ", m[X], " and take"];
eq[HoldForm[Subscript[o, n] == Mod[X, 2 A + 1] - A]];
txt["This is uniform on the ", m[HoldForm[2 A + 1]], " integers ", m[HoldForm[-A <= o <= A]],
  " up to a bias below ", m[HoldForm[(2 A + 1)/2^128]], ", about ", sci["1.9", -31],
  " at the largest ", m[A], ". It uses integer arithmetic only, so every implementation on every platform ",
  "produces the identical offset."];

subsec["5.4 Gaussian variate"];
txt["Split each block into four 64-bit big-endian words ", m[w], ". Each gives an exact dyadic uniform"];
eq[HoldForm[u == (Floor[w/2^11] + 1/2)/2^53]];
txt["strictly inside (0, 1) and exactly representable as a double. The standard normal variate is ",
  m[HoldForm[x == Subscript[\[CapitalPhi], AS241]^-1[u]]],
  ", Wichura's algorithm AS241 (PPND16, Applied Statistics 37, 1988), a rational approximation with relative ",
  "error near ", p10[-16], ". Draws are taken in order, block ", m[j], " = 0, 1, 2, \[Ellipsis], ",
  "word 0\[Dash]3, and the first with ", m[HoldForm[Abs[x] S <= C]], " is used:"];
eq[HoldForm[Subscript[o, n] == Round[x S]]];
txt["Rejection gives the exact normal truncated to \[PlusMinus]", m[C], " without needing ", m[erf],
  " anywhere. ", m[Round], " is to the nearest integer, ties to even. The constraint ", m[HoldForm[C >= S/2]],
  " keeps the acceptance probability above 38%, so the 256 draws available are never exhausted in practice ",
  "(failure probability below ", p10[-53], ")."];
txt[StyleBox["Exactness.", FontWeight -> "Bold"], " The specification is AS241 evaluated in exact real arithmetic ",
  "on the exact coefficients; this reference evaluates it at 60 digits. A double-precision evaluation agrees except ",
  "when ", m[HoldForm[x S]], " lies within about ", p10[-7], " ticks of a rounding boundary or of ",
  m[HoldForm[PlusMinus[C]]], "; there the Python implementation recomputes in ", mono["decimal"],
  " at 50 digits. That makes the offset, and so the inversion, identical on every machine, which a plain ",
  "floating-point evaluation (whose ", m[Log], " may differ by an ulp between C libraries) would not guarantee. ",
  "Section 8 constructs such near-tie cases deliberately."];

(* ======================================================================= *)
sec["6. The flat variate"];
code["flat = Table[offset[tokF, \"tdu-test\", n], {n, 20000}];\n{Min[flat], Max[flat], N[Mean[flat]], N[StandardDeviation[flat]], N[Sqrt[((2*3200000 + 1)^2 - 1)/12]]}"];
txt["Range, mean, standard deviation and the exact standard deviation ", m[HoldForm[Sqrt[((2 A + 1)^2 - 1)/12]]],
  " of the discrete uniform on \[PlusMinus]", m[A], ". In milliseconds the bound is 50 ms and \[Sigma] = 28.9 ms."];
code["Histogram[flat/64000., {-50, 50, 2}, \"PDF\", Frame -> True, FrameLabel -> {\"offset (ms)\", \"density\"},\n PlotLabel -> \"Flat, a = 50 ms: 20,000 events\", ImageSize -> 480,\n Epilog -> {Red, Line[{{-50, 1/100}, {50, 1/100}}]}]"];
code["PearsonChiSquareTest[flat, DiscreteUniformDistribution[{-3200000, 3200000}], \"TestDataTable\"]"];

(* ======================================================================= *)
sec["7. The Gaussian variate"];
subsec["7.1 AS241 accuracy"];
code["errs = Table[With[{u = uniformFromWord[RandomInteger[2^64 - 1]]},\n    {N[InverseCDF[NormalDistribution[], u], 30],\n     N[(as241[u] - InverseCDF[NormalDistribution[], u])/Max[1, Abs[InverseCDF[NormalDistribution[], u]]], 30]}], {3000}];\nN[Max[Abs[errs[[All, 2]]]]]"];
code["ListPlot[errs, Frame -> True, FrameLabel -> {\"x\", \"(AS241 \[Minus] exact) / max(1, |x|)\"},\n PlotLabel -> \"AS241 against the exact inverse CDF, 3000 random u\", ImageSize -> 480, PlotRange -> All]"];
txt["The worst relative error is ", p10[-16], " in size. At \[Sigma] = 500 ms, the largest allowed, ",
  "that is below ", p10[-8], " ticks: AS241 is indistinguishable from the exact normal at the ",
  "resolution of the clock."];
subsec["7.2 Sampling"];
code["gauss = Table[offsetGauss[parseToken[tokG][\"secret\"], \"dts1:gauss:sigma=1280000:cut=3840000\", 1280000, 3840000, \"tdu-test\", n], {n, 20000}];\n{Min[gauss[[All, 1]]], Max[gauss[[All, 1]]], N[Mean[gauss[[All, 1]]]], N[StandardDeviation[gauss[[All, 1]]]]}"];
code["sigmaTrunc[k_] := Sqrt[1 - 2 k PDF[NormalDistribution[], k]/(2 CDF[NormalDistribution[], k] - 1)];\nN[1280000 sigmaTrunc[3]]"];
txt["The standard deviation of a unit normal truncated at \[PlusMinus]", m[k], " is ",
  m[HoldForm[Sqrt[1 - 2 k \[Phi][k]/(2 \[CapitalPhi][k] - 1)]]], "; at ", m[HoldForm[k == 3]],
  " the expected value in ticks is above, matching the sample."];
code["Histogram[gauss[[All, 1]]/64000., {-60, 60, 2}, \"PDF\", Frame -> True,\n FrameLabel -> {\"offset (ms)\", \"density\"}, PlotLabel -> \"Gaussian, \[Sigma] = 20 ms, cut 60 ms: 20,000 events\", ImageSize -> 480] ~Show~\n Plot[PDF[TruncatedDistribution[{-60, 60}, NormalDistribution[0, 20]], t], {t, -60, 60}, PlotStyle -> Red]"];
code["KolmogorovSmirnovTest[N@gauss[[All, 2]], TruncatedDistribution[{-3, 3}, NormalDistribution[]], \"TestDataTable\"]"];
code["QuantilePlot[N@gauss[[All, 2]], TruncatedDistribution[{-3, 3}, NormalDistribution[]], ImageSize -> 360,\n Frame -> True, FrameLabel -> {\"truncated normal quantile\", \"sample quantile\"}]"];
code["{N[Mean[gauss[[All, 3]]]], N[1/(2 CDF[NormalDistribution[], 3] - 1)], Max[gauss[[All, 3]]]}"];
txt["Mean draws per event, its expectation ", m[HoldForm[1/(2 \[CapitalPhi][3] - 1)]],
  ", and the most any event needed."];

(* ======================================================================= *)
sec["8. Determinism near rounding boundaries"];
txt["Offsets near a half-tick are where floating point could disagree between machines. Search the ",
  "53-bit grid around chosen half-integers ", m[HoldForm[x S == m + 1/2]], " for the uniforms that land closest:"];
code["nearTie[S_, mm_] := Module[{x0 = (mm + 1/2)/S, k0, cands},\n   k0 = Floor[CDF[NormalDistribution[], N[x0, 50]] 2^53 - 1/2];\n   cands = Table[With[{u = (k + 1/2)/2^53}, {k, N[as241[u] S, 40]}], {k, k0 - 3, k0 + 3}];\n   First@SortBy[cands, Abs[FractionalPart[Abs[#[[2]]]] - 1/2] &]];\nties = Table[With[{r = nearTie[1280000, mm]}, <|\"sigma\" -> 1280000, \"k\" -> r[[1]],\n     \"xS\" -> ToString[NumberForm[r[[2]], 30, ExponentFunction -> (Null &)]], \"distance_from_half\" -> N[Abs[FractionalPart[Abs[r[[2]]]] - 1/2]],\n     \"offset\" -> Round[r[[2]]]|>], {mm, {12345, -400000, 1000000, -2500000, 3000000, 77}}];\nTableForm[Values /@ ties, TableHeadings -> {None, Keys[First[ties]]}]"];
txt["Distances of ", p10[-10], " ticks and below are far inside the error of a double-precision ",
  "evaluation. The Python implementation detects these and falls back to exact decimal arithmetic; these cases ",
  "are among its test vectors."];

(* ======================================================================= *)
sec["9. Inversion on real data"];
txt["The sample is ten minutes from the Near Detector, 2026-10-12 00:00\[Dash]00:10 UTC: three TDUs, ",
  ToString[4701], " events. Shift it with each token, then invert, and compare every transformed column."];
code["toRow[r_] := <|\"nova_time\" -> r[\"nova_time\"], \"source\" -> r[\"source\"],\n    \"event_number\" -> r[\"event_number\"], \"delta\" -> r[\"delta\"], \"pps_offset\" -> r[\"pps_offset\"]|>;\norig = toRow /@ rows;\nshiftedF = shiftRow[tokF, #] & /@ orig;\nshiftedG = shiftRow[tokG, #] & /@ orig;\n{invertRow[tokF, #] & /@ shiftedF === orig, invertRow[tokG, #] & /@ shiftedG === orig}"];
txt["Both round trips are exact on all ", ToString[4701], " rows and all columns. The shifted files are ",
  "self-consistent: wherever event ", m[n - 1], " is present, ", m[Subscript[\[CapitalDelta], n]^\[Prime]],
  " equals the gap between the shifted times, and ", m[Subscript[p, n]^\[Prime]], " equals the shifted phase."];
code["consistent[sh_] := Module[{bk = Association[(#[\"source\"] -> #[\"event_number\"]) -> #[\"nova_time\"] & /@ sh]},\n   Counts[Map[With[{p = bk[#[\"source\"] -> #[\"event_number\"] - 1]},\n      If[MissingQ[p], \"no predecessor\", #[\"delta\"] == #[\"nova_time\"] - p]] &, sh]]];\n{consistent[shiftedG], Counts[(#[\"pps_offset\"] == Mod[#[\"nova_time\"], $Ticks]) & /@ shiftedG]}"];
code["ListPlot[{(shiftedF[[All, \"nova_time\"]] - orig[[All, \"nova_time\"]])/64000.,\n  (shiftedG[[All, \"nova_time\"]] - orig[[All, \"nova_time\"]])/64000.}, Frame -> True,\n FrameLabel -> {\"row\", \"t' \[Minus] t (ms)\"}, PlotLegends -> Placed[{\"flat \[PlusMinus]50 ms\", \"Gaussian \[Sigma] 20 ms\"}, Below],\n PlotLabel -> \"Applied offsets, sample file\", ImageSize -> 520, PlotStyle -> PointSize[Small]]"];
subsec["9.1 The wrong token"];
txt["Inverting with a token that differs in one bit of the secret gives times that are wrong by the difference of ",
  "two independent offsets, with no visible sign of failure. Hence the fingerprint check."];
code["flip[tok_] := Module[{p = parseToken[tok], k}, k = Normal[p[\"secret\"]]; k[[1]] = BitXor[k[[1]], 1];\n   makeToken[KeyDrop[p, \"secret\"], ByteArray[k]]];\nwrongTok = flip[tokF];\n{fingerprint[tokF], fingerprint[wrongTok]}"];
code["bad = invertRow[wrongTok, #] & /@ shiftedF[[;; 2000]];\nHistogram[(bad[[All, \"nova_time\"]] - orig[[;; 2000, \"nova_time\"]])/64000., {-100, 100, 4}, \"PDF\",\n Frame -> True, FrameLabel -> {\"error after wrong inversion (ms)\", \"density\"}, ImageSize -> 420,\n PlotLabel -> \"Flat \[PlusMinus]50 ms, wrong token: triangular on \[PlusMinus]100 ms\"]"];

(* ======================================================================= *)
sec["10. Independence and key sensitivity"];
code["acf[v_, maxlag_] := With[{z = v - Mean[v]}, Table[Total[Most[RotateLeft[z, l]] z[[;; -2]]]/Total[z^2], {l, 1, maxlag}]];\nListPlot[{acf[N@flat, 40], acf[N@gauss[[All, 1]], 40]}, Filling -> Axis, Frame -> True,\n FrameLabel -> {\"lag in event_number\", \"autocorrelation\"}, PlotLegends -> {\"flat\", \"Gaussian\"},\n Epilog -> {Dashed, Gray, Line[{{0, 2/Sqrt[20000.]}, {41, 2/Sqrt[20000.]}}], Line[{{0, -2/Sqrt[20000.]}, {41, -2/Sqrt[20000.]}}]},\n PlotLabel -> \"Offsets of successive events (dashed: \[PlusMinus]2/\[Sqrt]N)\", ImageSize -> 480]"];
code["other = Table[offset[wrongTok, \"tdu-test\", n], {n, 3000}];\nCorrelation[N@flat[[;; 3000]], N@other]"];
txt["Offsets of neighbouring events are uncorrelated, and a one-bit change of the secret gives an unrelated ",
  "sequence (correlation consistent with zero at ", m[HoldForm[1/Sqrt[3000] \[TildeTilde] 0.018]], ")."];

(* ======================================================================= *)
sec["11. What the blur hides, and what it does not"];
subsec["11.1 Sub-second phase"];
txt["The 1 Hz pulser (", mono["$8F"], ", type ", mono["ACCEL_ONE_HZ_TCLK"], ") fires 22 \[Micro]s after each ",
  "second. Its phase before and after:"];
code["idx = Flatten@Position[rows[[All, \"spill_type_name\"]], \"ACCEL_ONE_HZ_TCLK\"];\nonehz = Transpose[{orig[[idx]], shiftedG[[idx]]}];\nLength[onehz]"];
code["phase[t_] := With[{f = Mod[t, $Ticks]}, If[f > $Ticks/2, f - $Ticks, f]/64000.];\nGraphicsRow[{\n  Histogram[phase /@ onehz[[All, 1, \"nova_time\"]], {-0.01, 0.05, 0.002}, Frame -> True, FrameLabel -> {\"phase (ms)\", \"count\"}, PlotLabel -> \"true\"],\n  Histogram[phase /@ onehz[[All, 2, \"nova_time\"]], {-80, 80, 4}, Frame -> True, FrameLabel -> {\"phase (ms)\", \"count\"}, PlotLabel -> \"shifted, Gaussian \[Sigma] 20 ms\"]}, ImageSize -> 640]"];
txt["The blur hides when within the second each pulse fired. It cannot hide that the pulser is periodic: ",
  "anyone who knows a signal fires on the second can round each shifted time to the nearest second and so learn ",
  "that event's offset, as long as the bound is below 500 ms. That reveals nothing about any other event, because ",
  "offsets are independent, but the times of predictable events are effectively public whatever is done to them."];
subsec["11.2 Order"];
txt[mono["event_number"], " must stay in the file for inversion, and it numbers events in true order. The order of ",
  "events is therefore not hidden, only their times. The shifted times themselves can come out of order when ",
  "events are closer together than the blur:"];
code["reorder[sh_] := Module[{bysrc = GroupBy[sh, #[\"source\"] &]},\n   N@Mean[Flatten[Values[Map[With[{s = SortBy[#, #[\"event_number\"] &]},\n         Boole[Thread[Differences[s[[All, \"nova_time\"]]] < 0]]] &, bysrc]]]]];\nxs = Table[offsetGauss[parseToken[tokG][\"secret\"], \"dts1:gauss:sigma=1280000:cut=3840000\", 1280000, 3840000, r[\"source\"], r[\"event_number\"]][[2]], {r, orig}];\nsigmas = {0.5, 1, 2, 5, 10, 20, 50, 100, 500/3};\nfrac = Table[{s, reorder[MapThread[Append[#1, \"nova_time\" -> #1[\"nova_time\"] + Round[#2 s 64000]] &, {orig, xs}]]}, {s, sigmas}]"];
code["ListLogLinearPlot[frac, Joined -> True, Mesh -> All, Frame -> True, ImageSize -> 480,\n FrameLabel -> {\"Gaussian \[Sigma] (ms), cut 3\[Sigma]\", \"fraction of successive events out of order\"},\n PlotLabel -> \"Order inversions in the sample (BNB_TCLK events ~67 ms apart on ppc-01)\"]"];
txt["(The draws here reuse one token's normal variates, scaled to each \[Sigma], to isolate the dependence on width.) ",
  "Up to 1 ms nothing reorders and up to 10 ms fewer than 0.1% of neighbours swap; at 20 ms it is about 0.6%, ",
  "and by 50 ms about 9%, as the ", mono["BNB_TCLK"], " events on ", mono["ppc-01"],
  ", 67 ms apart, start to cross. \[Sigma] = 500/3 ms is the widest Gaussian whose 3\[Sigma] cut fits the 500 ms ceiling. Sorting a shifted file by time therefore does not give the true ",
  "order, but sorting by ", mono["event_number"], " does."];
subsec["11.3 Summary"];
item[StyleBox["Hidden:", FontWeight -> "Bold"], " each event's time to within the chosen distribution; its ",
  "sub-second phase; the exact spacing of events (", mono["delta"], " is blurred by ",
  m[HoldForm[Subscript[o, n] - Subscript[o, n - 1]]], ")."];
item[StyleBox["Not hidden:", FontWeight -> "Bold"], " event order and counts, types and sources; times of events ",
  "that are predictable from structure (periodic signals); anything outside the file."];
item[StyleBox["Key reuse:", FontWeight -> "Bold"], " ", mono["event_number"], " restarts when TCRMonitor restarts, ",
  "so two events weeks apart can share (", mono["source"], ", ", m[n], ") and hence an offset. Inversion is ",
  "unaffected; an observer who could match such pairs learns that their offsets are equal, not what they are."];
item[StyleBox["Seeds:", FontWeight -> "Bold"], " a seed-derived token is as strong as the seed. Use a generated ",
  "token when the blur protects something."];

