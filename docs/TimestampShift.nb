Cell["\<\
The blur hides when within the second each pulse fired. It cannot hide that \
the pulser is periodic: anyone who knows a signal fires on the second can \
round each shifted time to the nearest second and so learn that event's \
offset, as long as the bound is below 500 ms. That reveals nothing about any \
other event, because offsets are independent, but the times of predictable \
events are effectively public whatever is done to them.\
\>", "Text"]
}, Open  ]],

Cell[CellGroupData[{

Cell["11.2 Order", "Subsection"],

Cell[TextData[{
 StyleBox["event_number",
  FontFamily->"Courier"],
 " must stay in the file for inversion, and it numbers events in true order. \
The order of ",
 "events is therefore not hidden, only their times. The shifted times \
themselves can come out of order when ",
 "events are closer together than the blur:"
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"reorder", "[", "sh_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"bysrc", " ", "=", " ", 
       RowBox[{"GroupBy", "[", 
        RowBox[{"sh", ",", " ", 
         RowBox[{
          RowBox[{"#", "[", "\"\<source\>\"", "]"}], " ", "&"}]}], "]"}]}], 
      "}"}], ",", "\n", "   ", 
     RowBox[{"N", "@", 
      RowBox[{"Mean", "[", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Values", "[", 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"With", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"s", " ", "=", " ", 
                RowBox[{"SortBy", "[", 
                 RowBox[{"#", ",", " ", 
                  RowBox[{
                   RowBox[{"#", "[", "\"\<event_number\>\"", "]"}], " ", 
                   "&"}]}], "]"}]}], "}"}], ",", "\n", "         ", 
              RowBox[{"Boole", "[", 
               RowBox[{"Thread", "[", 
                RowBox[{
                 RowBox[{"Differences", "[", 
                  RowBox[{"s", "[", 
                   RowBox[{"[", 
                    RowBox[{"All", ",", " ", "\"\<nova_time\>\""}], "]"}], 
                   "]"}], "]"}], " ", "<", " ", "0"}], "]"}], "]"}]}], "]"}], 
            " ", "&"}], ",", " ", "bysrc"}], "]"}], "]"}], "]"}], "]"}]}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"xs", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"offsetGauss", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"parseToken", "[", "tokG", "]"}], "[", "\"\<secret\>\"", 
         "]"}], ",", " ", "\"\<dts1:gauss:sigma=1280000:cut=3840000\>\"", ",",
         " ", "1280000", ",", " ", "3840000", ",", " ", 
        RowBox[{"r", "[", "\"\<source\>\"", "]"}], ",", " ", 
        RowBox[{"r", "[", "\"\<event_number\>\"", "]"}]}], "]"}], "[", 
      RowBox[{"[", "2", "]"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"r", ",", " ", "orig"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sigmas", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
    "0.5", ",", " ", "1", ",", " ", "2", ",", " ", "5", ",", " ", "10", ",", 
     " ", "20", ",", " ", "50", ",", " ", "100", ",", " ", 
     RowBox[{"500", "/", "3"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{"frac", " ", "=", " ", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"s", ",", " ", 
      RowBox[{"reorder", "[", 
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Append", "[", 
           RowBox[{"#1", ",", " ", 
            RowBox[{"\"\<nova_time\>\"", " ", "->", " ", 
             RowBox[{
              RowBox[{"#1", "[", "\"\<nova_time\>\"", "]"}], " ", "+", " ", 
              RowBox[{"Round", "[", 
               RowBox[{"#2", " ", "s", " ", "64000"}], "]"}]}]}]}], "]"}], 
          " ", "&"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"orig", ",", " ", "xs"}], "}"}]}], "]"}], "]"}]}], "}"}], 
    ",", " ", 
    RowBox[{"{", 
     RowBox[{"s", ",", " ", "sigmas"}], "}"}]}], "]"}]}]}], "Input",
 CellLabel->"In[57]:=",ExpressionUUID->"ad0eda9e-8c56-4d4c-a198-972012c64dec"],

