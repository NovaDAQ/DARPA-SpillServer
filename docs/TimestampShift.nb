       RowBox[{"[", "idx", "]"}], "]"}], ",", " ", 
      RowBox[{"shiftedG", "[", 
       RowBox[{"[", "idx", "]"}], "]"}]}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{"Length", "[", "onehz", "]"}]}], "Input",
 CellLabel->"In[52]:=",ExpressionUUID->"74f51ae5-5340-4ba1-8b55-a356a0b0db56"],

