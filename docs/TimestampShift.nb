Cell[TextData[{
 "The worst relative error is ",
 Cell[BoxData[
  SuperscriptBox["10", 
   RowBox[{"\[Minus]", "16"}]]]],
 " in size. At \[Sigma] = 500 ms, the largest allowed, ",
 "that is below ",
 Cell[BoxData[
  SuperscriptBox["10", 
   RowBox[{"\[Minus]", "8"}]]]],
 " ticks: AS241 is indistinguishable from the exact normal at the ",
 "resolution of the clock."
}], "Text"]
}, Open  ]],

Cell[CellGroupData[{

Cell["7.2 Sampling", "Subsection"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"gauss", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"offsetGauss", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"parseToken", "[", "tokG", "]"}], "[", "\"\<secret\>\"", 
        "]"}], ",", " ", "\"\<dts1:gauss:sigma=1280000:cut=3840000\>\"", ",", 
       " ", "1280000", ",", " ", "3840000", ",", " ", "\"\<tdu-test\>\"", ",",
        " ", "n"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"n", ",", " ", "20000"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Min", "[", 
    RowBox[{"gauss", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], "]"}], ",", " ", 
   RowBox[{"Max", "[", 
    RowBox[{"gauss", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], "]"}], ",", " ", 
   RowBox[{"N", "[", 
    RowBox[{"Mean", "[", 
     RowBox[{"gauss", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], "]"}], "]"}], ",", " ", 
   RowBox[{"N", "[", 
    RowBox[{"StandardDeviation", "[", 
     RowBox[{"gauss", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], "]"}], "]"}]}], 
  "}"}]}], "Input",
 CellLabel->"In[24]:=",ExpressionUUID->"a839bb3f-79cf-4773-8098-b92f428e6679"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"-", "3828386"}], ",", "3839899", ",", "9896.40865`", ",", 
   "1.2610204371386801`*^6"}], "}"}]], "Output",
 CellChangeTimes->{4.001593465113154*^9},
 CellLabel->"Out[25]=",ExpressionUUID->"0640debc-5660-4c82-9ca1-b8684ac40cc0"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"sigmaTrunc", "[", "k_", "]"}], " ", ":=", " ", 
   RowBox[{"Sqrt", "[", 
    RowBox[{"1", " ", "-", " ", 
     RowBox[{"2", " ", "k", " ", 
      RowBox[{
       RowBox[{"PDF", "[", 
        RowBox[{
         RowBox[{"NormalDistribution", "[", "]"}], ",", " ", "k"}], "]"}], 
       "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", " ", 
          RowBox[{"CDF", "[", 
           RowBox[{
            RowBox[{"NormalDistribution", "[", "]"}], ",", " ", "k"}], 
           "]"}]}], " ", "-", " ", "1"}], ")"}]}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"N", "[", 
  RowBox[{"1280000", " ", 
   RowBox[{"sigmaTrunc", "[", "3", "]"}]}], "]"}]}], "Input",
 CellLabel->"In[26]:=",ExpressionUUID->"26671132-1a6d-4d95-a887-a949b19362f4"],

Cell[BoxData["1.262820342474379`*^6"], "Output",
 CellChangeTimes->{4.001593465229107*^9},
 CellLabel->"Out[27]=",ExpressionUUID->"53c8b92a-2b3c-4315-9f14-c523a234608d"]
}, Open  ]],

Cell[TextData[{
 "The standard deviation of a unit normal truncated at \[PlusMinus]",
 Cell[BoxData[
  FormBox["k", TraditionalForm]]],
 " is ",
 Cell[BoxData[
  FormBox[
   TagBox[
    SqrtBox[
     RowBox[{"1", "-", 
      FractionBox[
       RowBox[{"2", " ", "k", " ", 
        RowBox[{"\[Phi]", "(", "k", ")"}]}], 
       RowBox[{
        RowBox[{"2", " ", 
         RowBox[{"\[CapitalPhi]", "(", "k", ")"}]}], "-", "1"}]]}]],
    HoldForm], TraditionalForm]]],
 "; at ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{"k", "\[LongEqual]", "3"}],
    HoldForm], TraditionalForm]]],
 " the expected value in ticks is above, matching the sample."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Histogram", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"gauss", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], "/", "64000."}], ",", 
    " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "60"}], ",", " ", "60", ",", " ", "2"}], "}"}], ",", " ", 
