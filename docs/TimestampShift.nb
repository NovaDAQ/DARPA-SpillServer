    Charting`ScaledTicks[{Log, Exp}], Automatic}]], "Output",
 CellChangeTimes->{4.001593523949502*^9},
 CellLabel->"Out[61]=",ExpressionUUID->"08da9082-4e39-45a1-b0fa-c07af661fb42"]
}, Open  ]],

Cell[TextData[{
 "(The draws here reuse one token's normal variates, scaled to each \[Sigma], \
to isolate the dependence on width.) ",
 "Up to 1 ms nothing reorders and up to 10 ms fewer than 0.1% of neighbours \
swap; at 20 ms it is about 0.6%, ",
 "and by 50 ms about 9%, as the ",
 StyleBox["BNB_TCLK",
  FontFamily->"Courier"],
 " events on ",
 StyleBox["ppc-01",
  FontFamily->"Courier"],
 ", 67 ms apart, start to cross. \[Sigma] = 500/3 ms is the widest Gaussian \
whose 3\[Sigma] cut fits the 500 ms ceiling. Sorting a shifted file by time \
therefore does not give the true ",
 "order, but sorting by ",
 StyleBox["event_number",
  FontFamily->"Courier"],
 " does."
}], "Text"]
}, Open  ]],

Cell[CellGroupData[{

Cell["11.3 Summary", "Subsection"],

Cell[CellGroupData[{

Cell[TextData[{
 StyleBox["Hidden:",
  FontWeight->"Bold"],
 " each event's time to within the chosen distribution; its ",
 "sub-second phase; the exact spacing of events (",
 StyleBox["delta",
  FontFamily->"Courier"],
 " is blurred by ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     SubscriptBox["o", "n"], "-", 
     SubscriptBox["o", 
      RowBox[{"n", "-", "1"}]]}],
    HoldForm], TraditionalForm]]],
 ")."
}], "Item"],

Cell[TextData[{
 StyleBox["Not hidden:",
  FontWeight->"Bold"],
 " event order and counts, types and sources; times of events ",
 "that are predictable from structure (periodic signals); anything outside \
the file."
}], "Item"],

Cell[TextData[{
 StyleBox["Key reuse:",
  FontWeight->"Bold"],
 " ",
 StyleBox["event_number",
  FontFamily->"Courier"],
 " restarts when TCRMonitor restarts, ",
 "so two events weeks apart can share (",
 StyleBox["source",
  FontFamily->"Courier"],
 ", ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]]],
 ") and hence an offset. Inversion is ",
 "unaffected; an observer who could match such pairs learns that their \
offsets are equal, not what they are."
}], "Item"],

Cell[TextData[{
 StyleBox["Seeds:",
  FontWeight->"Bold"],
 " a seed-derived token is as strong as the seed. Use a generated ",
 "token when the blur protects something."
}], "Item"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["12. Test vectors", "Section"],

Cell[TextData[{
 "Written to ",
 StyleBox["docs/shift/dts1_test_vectors.json",
  FontFamily->"Courier"],
 " for the Python tests: the HMAC and PBKDF2 checks, ",
 "offsets for edge-case event numbers under both tokens, the near-tie cases \
of section 8, and the first 500 ",
 "shifted rows of the sample under each token."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"edgeNs", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "1"}], ",", " ", "0", ",", " ", "1", ",", " ", "2", ",", 
     " ", "3", ",", " ", "178098", ",", " ", 
     RowBox[{
      RowBox[{"2", "^", "31"}], " ", "-", " ", "1"}], ",", " ", 
     RowBox[{"2", "^", "31"}], ",", " ", 
     RowBox[{"2", "^", "53"}], ",", " ", 
     RowBox[{"10", "^", "15"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"vectors", " ", "=", " ", 
   RowBox[{"<|", "\n", "  ", 
    RowBox[{
     RowBox[{"\"\<spec\>\"", " ", "->", " ", "\"\<dts1\>\""}], ",", "\n", 
     "  ", 
     RowBox[{
     "\"\<hmac_rfc4231_case2\>\"", " ", "->", " ", 
      "\"\<5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843\>\
\""}], ",", "\n", "  ", 
     RowBox[{"\"\<pbkdf2\>\"", " ", "->", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{
        "\"\<seed\>\"", " ", "->", " ", 
         "\"\<correct horse battery staple\>\""}], ",", " ", 
        RowBox[{
        "\"\<salt\>\"", " ", "->", " ", "\"\<darpa-spill-shift/dts1\>\""}], 
        ",", " ", 
        RowBox[{"\"\<iterations\>\"", " ", "->", " ", "1000"}], ",", "\n", 
        "     ", 
        RowBox[{"\"\<secret_hex\>\"", " ", "->", " ", 
         RowBox[{"StringJoin", "[", 
          RowBox[{"IntegerString", "[", 
           RowBox[{
            RowBox[{"Normal", "@", 
             RowBox[{"pbkdf2SHA256", "[", 
              RowBox[{
              "\"\<correct horse battery staple\>\"", ",", " ", 
               "\"\<darpa-spill-shift/dts1\>\"", ",", " ", "1000"}], "]"}]}], 
            ",", " ", "16", ",", " ", "2"}], "]"}], "]"}]}]}], "|>"}]}], ",", 
     "\n", "  ", 
     RowBox[{"\"\<tokens\>\"", " ", "->", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<flat\>\"", " ", "->", " ", "tokF"}], ",", " ", 
        RowBox[{"\"\<gauss\>\"", " ", "->", " ", "tokG"}]}], "|>"}]}], ",", 
     "\n", "  ", 
     RowBox[{"\"\<fingerprints\>\"", " ", "->", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<flat\>\"", " ", "->", " ", 
         RowBox[{"fingerprint", "[", "tokF", "]"}]}], ",", " ", 
        RowBox[{"\"\<gauss\>\"", " ", "->", " ", 
         RowBox[{"fingerprint", "[", "tokG", "]"}]}]}], "|>"}]}], ",", "\n", 
     "  ", 
     RowBox[{"\"\<offsets\>\"", " ", "->", " ", 
      RowBox[{"Flatten", "@", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<token\>\"", " ", "->", " ", "name"}], ",", " ", 
           RowBox[{"\"\<source\>\"", " ", "->", " ", "src"}], ",", " ", 
           RowBox[{"\"\<n\>\"", " ", "->", " ", "n"}], ",", "\n", "       ", 
           RowBox[{"\"\<offset\>\"", " ", "->", " ", 
            RowBox[{"offset", "[", 
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"name", " ", "==", " ", "\"\<flat\>\""}], ",", " ", 
                "tokF", ",", " ", "tokG"}], "]"}], ",", " ", "src", ",", " ", 
              "n"}], "]"}]}]}], "|>"}], ",", "\n", "      ", 
         RowBox[{"{", 
          RowBox[{"name", ",", " ", 
           RowBox[{"{", 
            RowBox[{"\"\<flat\>\"", ",", " ", "\"\<gauss\>\""}], "}"}]}], 
          "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"src", ",", " ", 
           RowBox[{"{", 
            RowBox[{"\"\<tdu-near-master-ppc-01\>\"", ",", " ", "\"\<x\>\""}],
             "}"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"n", ",", " ", "edgeNs"}], "}"}]}], "]"}]}]}], ",", "\n", 
     "  ", 
     RowBox[{"\"\<near_ties\>\"", " ", "->", " ", "ties"}], ",", "\n", "  ", 
     RowBox[{
     "\"\<sample_file\>\"", " ", "->", " ", 
      "\"\<sample_2026-10-12T0000_10min.csv\>\""}], ",", "\n", "  ", 
     RowBox[{"\"\<shifted_sample\>\"", " ", "->", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<flat\>\"", " ", "->", " ", 
         RowBox[{"Values", " ", "/@", " ", 
          RowBox[{"shiftedF", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{";;", " ", "500"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{
              "\"\<nova_time\>\"", ",", " ", "\"\<delta\>\"", ",", " ", 
               "\"\<pps_offset\>\""}], "}"}]}], "]"}], "]"}]}]}], ",", "\n", 
        "     ", 
        RowBox[{"\"\<gauss\>\"", " ", "->", " ", 
         RowBox[{"Values", " ", "/@", " ", 
          RowBox[{"shiftedG", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{";;", " ", "500"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{
              "\"\<nova_time\>\"", ",", " ", "\"\<delta\>\"", ",", " ", 
               "\"\<pps_offset\>\""}], "}"}]}], "]"}], "]"}]}]}]}], 
       "|>"}]}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{"$dataDir", ",", " ", "\"\<dts1_test_vectors.json\>\""}], "}"}],
      "]"}], ",", " ", "vectors", ",", " ", "\"\<RawJSON\>\""}], "]"}], 
  ";"}], "\n", 
 RowBox[{"Keys", "[", "vectors", "]"}]}], "Input",
