Cell[CellGroupData[{

Cell["9.1 The wrong token", "Subsection"],

Cell["\<\
Inverting with a token that differs in one bit of the secret gives times that \
are wrong by the difference of two independent offsets, with no visible sign \
of failure. Hence the fingerprint check.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"flip", "[", "tok_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"p", " ", "=", " ", 
        RowBox[{"parseToken", "[", "tok", "]"}]}], ",", " ", "k"}], "}"}], 
     ",", " ", 
     RowBox[{
      RowBox[{"k", " ", "=", " ", 
       RowBox[{"Normal", "[", 
        RowBox[{"p", "[", "\"\<secret\>\"", "]"}], "]"}]}], ";", " ", 
      RowBox[{
       RowBox[{"k", "[", 
        RowBox[{"[", "1", "]"}], "]"}], " ", "=", " ", 
       RowBox[{"BitXor", "[", 
        RowBox[{
         RowBox[{"k", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", " ", "1"}], "]"}]}], ";", "\n",
       "   ", 
      RowBox[{"makeToken", "[", 
       RowBox[{
        RowBox[{"KeyDrop", "[", 
         RowBox[{"p", ",", " ", "\"\<secret\>\""}], "]"}], ",", " ", 
        RowBox[{"ByteArray", "[", "k", "]"}]}], "]"}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"wrongTok", " ", "=", " ", 
   RowBox[{"flip", "[", "tokF", "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"fingerprint", "[", "tokF", "]"}], ",", " ", 
   RowBox[{"fingerprint", "[", "wrongTok", "]"}]}], "}"}]}], "Input",
 CellLabel->"In[43]:=",ExpressionUUID->"2381cb55-01df-4c0e-803d-4651e476da60"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"7a63e2a2874c456f\"\>", ",", "\<\"f07f54427077f463\"\>"}], 
  "}"}]], "Output",
 CellChangeTimes->{4.001593510449026*^9},
 CellLabel->"Out[45]=",ExpressionUUID->"c7c11134-cef7-41a5-aa6c-e4899d0a5ffd"]
}, Open  ]],

