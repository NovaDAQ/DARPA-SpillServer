Cell[TextData[{
 "Distances of ",
 Cell[BoxData[
  SuperscriptBox["10", 
   RowBox[{"\[Minus]", "10"}]]]],
 " ticks and below are far inside the error of a double-precision ",
 "evaluation. The Python implementation detects these and falls back to exact \
decimal arithmetic; these cases ",
 "are among its test vectors."
}], "Text"]
}, Open  ]],

Cell[CellGroupData[{

Cell["9. Inversion on real data", "Section"],

Cell["\<\
The sample is ten minutes from the Near Detector, 2026-10-12 \
00:00\[Dash]00:10 UTC: three TDUs, 4701 events. Shift it with each token, \
then invert, and compare every transformed column.\
\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"toRow", "[", "r_", "]"}], " ", ":=", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<nova_time\>\"", " ", "->", " ", 
      RowBox[{"r", "[", "\"\<nova_time\>\"", "]"}]}], ",", " ", 
     RowBox[{"\"\<source\>\"", " ", "->", " ", 
      RowBox[{"r", "[", "\"\<source\>\"", "]"}]}], ",", "\n", "    ", 
     RowBox[{"\"\<event_number\>\"", " ", "->", " ", 
      RowBox[{"r", "[", "\"\<event_number\>\"", "]"}]}], ",", " ", 
     RowBox[{"\"\<delta\>\"", " ", "->", " ", 
      RowBox[{"r", "[", "\"\<delta\>\"", "]"}]}], ",", " ", 
     RowBox[{"\"\<pps_offset\>\"", " ", "->", " ", 
      RowBox[{"r", "[", "\"\<pps_offset\>\"", "]"}]}]}], "|>"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"orig", " ", "=", " ", 
   RowBox[{"toRow", " ", "/@", " ", "rows"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"shiftedF", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"shiftRow", "[", 
      RowBox[{"tokF", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
    "orig"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"shiftedG", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"shiftRow", "[", 
      RowBox[{"tokG", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
    "orig"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"invertRow", "[", 
       RowBox[{"tokF", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
     "shiftedF"}], " ", "===", " ", "orig"}], ",", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"invertRow", "[", 
       RowBox[{"tokG", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
     "shiftedG"}], " ", "===", " ", "orig"}]}], "}"}]}], "Input",
 CellLabel->"In[35]:=",ExpressionUUID->"3686cac1-5d40-4c0a-aab9-6de7a2ec0122"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellChangeTimes->{4.001593510140768*^9},
 CellLabel->"Out[39]=",ExpressionUUID->"5781166d-0f4e-4fdf-a8ac-d430a8832020"]
}, Open  ]],

Cell[TextData[{
 "Both round trips are exact on all ",
 "4701",
 " rows and all columns. The shifted files are ",
 "self-consistent: wherever event ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "-", "1"}], TraditionalForm]]],
 " is present, ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[CapitalDelta]", "n", "\[Prime]"], TraditionalForm]]],
 " equals the gap between the shifted times, and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["p", "n", "\[Prime]"], TraditionalForm]]],
 " equals the shifted phase."
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"consistent", "[", "sh_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"bk", " ", "=", " ", 
       RowBox[{"Association", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"#", "[", "\"\<source\>\"", "]"}], " ", "->", " ", 
             RowBox[{"#", "[", "\"\<event_number\>\"", "]"}]}], ")"}], " ", "->",
            " ", 
           RowBox[{"#", "[", "\"\<nova_time\>\"", "]"}]}], " ", "&"}], " ", "/@",
          " ", "sh"}], "]"}]}], "}"}], ",", "\n", "   ", 
     RowBox[{"Counts", "[", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"p", " ", "=", " ", 
             RowBox[{"bk", "[", 
              RowBox[{
               RowBox[{"#", "[", "\"\<source\>\"", "]"}], " ", "->", " ", 
               RowBox[{
                RowBox[{"#", "[", "\"\<event_number\>\"", "]"}], " ", "-", 
                " ", "1"}]}], "]"}]}], "}"}], ",", "\n", "      ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"MissingQ", "[", "p", "]"}], ",", " ", 
             "\"\<no predecessor\>\"", ",", " ", 
             RowBox[{
              RowBox[{"#", "[", "\"\<delta\>\"", "]"}], " ", "==", " ", 
              RowBox[{
               RowBox[{"#", "[", "\"\<nova_time\>\"", "]"}], " ", "-", " ", 
               "p"}]}]}], "]"}]}], "]"}], " ", "&"}], ",", " ", "sh"}], "]"}],
       "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"consistent", "[", "shiftedG", "]"}], ",", " ", 
   RowBox[{"Counts", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"#", "[", "\"\<pps_offset\>\"", "]"}], " ", "==", " ", 
        RowBox[{"Mod", "[", 
         RowBox[{
          RowBox[{"#", "[", "\"\<nova_time\>\"", "]"}], ",", " ", "$Ticks"}], 
         "]"}]}], ")"}], " ", "&"}], " ", "/@", " ", "shiftedG"}], "]"}]}], 
  "}"}]}], "Input",
 CellLabel->"In[40]:=",ExpressionUUID->"e2ead66a-6b78-4e1f-9a24-7d3d9bf4c2b6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"no predecessor\"\>", "\[Rule]", "612"}], ",", 
     RowBox[{"True", "\[Rule]", "4089"}]}], "\[RightAssociation]"}], ",", 
   RowBox[{"\[LeftAssociation]", 
    RowBox[{"True", "\[Rule]", "4701"}], "\[RightAssociation]"}]}], 
  "}"}]], "Output",
 CellChangeTimes->{4.001593510256192*^9},
 CellLabel->"Out[41]=",ExpressionUUID->"e639d350-6399-4273-b8bf-7b43528b40a9"]
}, Open  ]],

