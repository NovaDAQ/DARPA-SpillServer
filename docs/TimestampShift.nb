       RowBox[{"[", 
        RowBox[{"All", ",", " ", "\"\<spill_type_name\>\""}], "]"}], "]"}], 
      ",", " ", "\"\<ACCEL_ONE_HZ_TCLK\>\""}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"onehz", " ", "=", " ", 
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
