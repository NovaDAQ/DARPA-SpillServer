        Offset[0.2]}}],
   {None, OutputFormsDump`HeadedColumns}],
  Function[BoxForm`e$, 
   TableForm[
   BoxForm`e$, 
    TableHeadings -> {
     None, {"sigma", "k", "xS", "distance_from_half", "offset"}}]]]], "Output",\

 CellChangeTimes->{4.001593469117128*^9},
 CellLabel->
  "Out[34]//TableForm=",ExpressionUUID->"69c989b7-fb85-43dc-8d63-\
755c73133903"]
