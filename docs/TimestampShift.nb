Cell[CellGroupData[{

Cell["10. Independence and key sensitivity", "Section"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"acf", "[", 
    RowBox[{"v_", ",", " ", "maxlag_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"z", " ", "=", " ", 
       RowBox[{"v", " ", "-", " ", 
        RowBox[{"Mean", "[", "v", "]"}]}]}], "}"}], ",", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Total", "[", 
         RowBox[{
          RowBox[{"Most", "[", 
           RowBox[{"RotateLeft", "[", 
            RowBox[{"z", ",", " ", "l"}], "]"}], "]"}], " ", 
          RowBox[{"z", "[", 
           RowBox[{"[", 
            RowBox[{";;", " ", 
             RowBox[{"-", "2"}]}], "]"}], "]"}]}], "]"}], "/", 
        RowBox[{"Total", "[", 
         RowBox[{"z", "^", "2"}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"l", ",", " ", "1", ",", " ", "maxlag"}], "}"}]}], "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"acf", "[", 
      RowBox[{
       RowBox[{"N", "@", "flat"}], ",", " ", "40"}], "]"}], ",", " ", 
     RowBox[{"acf", "[", 
      RowBox[{
       RowBox[{"N", "@", 
        RowBox[{"gauss", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", "1"}], "]"}], "]"}]}], ",", " ", "40"}], 
      "]"}]}], "}"}], ",", " ", 
   RowBox[{"Filling", " ", "->", " ", "Axis"}], ",", " ", 
   RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", " ", 
   RowBox[{"FrameLabel", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
     "\"\<lag in event_number\>\"", ",", " ", "\"\<autocorrelation\>\""}], 
     "}"}]}], ",", " ", 
   RowBox[{"PlotLegends", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<flat\>\"", ",", " ", "\"\<Gaussian\>\""}], "}"}]}], ",", 
   "\n", " ", 
   RowBox[{"Epilog", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"Dashed", ",", " ", "Gray", ",", " ", 
      RowBox[{"Line", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", 
           RowBox[{"2", "/", 
            RowBox[{"Sqrt", "[", "20000.", "]"}]}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"41", ",", " ", 
           RowBox[{"2", "/", 
            RowBox[{"Sqrt", "[", "20000.", "]"}]}]}], "}"}]}], "}"}], "]"}], 
      ",", " ", 
      RowBox[{"Line", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", " ", 
           RowBox[{
            RowBox[{"-", "2"}], "/", 
            RowBox[{"Sqrt", "[", "20000.", "]"}]}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"41", ",", " ", 
           RowBox[{
            RowBox[{"-", "2"}], "/", 
            RowBox[{"Sqrt", "[", "20000.", "]"}]}]}], "}"}]}], "}"}], "]"}]}],
      "}"}]}], ",", "\n", " ", 
   RowBox[{
   "PlotLabel", " ", "->", " ", 
    "\"\<Offsets of successive events (dashed: \[PlusMinus]2/\[Sqrt]N)\>\""}],
    ",", " ", 
   RowBox[{"ImageSize", " ", "->", " ", "480"}]}], "]"}]}], "Input",
 CellLabel->"In[48]:=",ExpressionUUID->"910df98a-31b1-400b-9647-6519a8da101e"],

