Cell[CellGroupData[{

Cell["7. The Gaussian variate", "Section"],

Cell[CellGroupData[{

Cell["7.1 AS241 accuracy", "Subsection"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"errs", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"u", " ", "=", " ", 
         RowBox[{"uniformFromWord", "[", 
          RowBox[{"RandomInteger", "[", 
           RowBox[{
            RowBox[{"2", "^", "64"}], " ", "-", " ", "1"}], "]"}], "]"}]}], 
        "}"}], ",", "\n", "    ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{"InverseCDF", "[", 
            RowBox[{
             RowBox[{"NormalDistribution", "[", "]"}], ",", " ", "u"}], "]"}],
            ",", " ", "30"}], "]"}], ",", "\n", "     ", 
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"as241", "[", "u", "]"}], " ", "-", " ", 
              RowBox[{"InverseCDF", "[", 
               RowBox[{
                RowBox[{"NormalDistribution", "[", "]"}], ",", " ", "u"}], 
               "]"}]}], ")"}], "/", 
            RowBox[{"Max", "[", 
             RowBox[{"1", ",", " ", 
              RowBox[{"Abs", "[", 
               RowBox[{"InverseCDF", "[", 
                RowBox[{
                 RowBox[{"NormalDistribution", "[", "]"}], ",", " ", "u"}], 
                "]"}], "]"}]}], "]"}]}], ",", " ", "30"}], "]"}]}], "}"}]}], 
      "]"}], ",", " ", 
     RowBox[{"{", "3000", "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"N", "[", 
  RowBox[{"Max", "[", 
   RowBox[{"Abs", "[", 
    RowBox[{"errs", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "]"}], "]"}], 
  "]"}]}], "Input",
 CellLabel->"In[21]:=",ExpressionUUID->"80fa0202-878d-466b-8225-8bb12fe6d6a7"],

Cell[BoxData["7.429787626987562`*^-17"], "Output",
 CellChangeTimes->{4.001593440567794*^9},
 CellLabel->"Out[22]=",ExpressionUUID->"f51feb2a-e137-4cc9-81fb-0fd3e49af791"]
}, Open  ]],

