Cell[TextData[{
 "Offsets of neighbouring events are uncorrelated, and a one-bit change of \
the secret gives an unrelated ",
 "sequence (correlation consistent with zero at ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     FractionBox["1", 
      SqrtBox["3000"]], "\[TildeTilde]", "0.018`"}],
    HoldForm], TraditionalForm]]],
 ")."
}], "Text"]
}, Open  ]],

Cell[CellGroupData[{

Cell["11. What the blur hides, and what it does not", "Section"],

Cell[CellGroupData[{

Cell["11.1 Sub-second phase", "Subsection"],

Cell[TextData[{
 "The 1 Hz pulser (",
 StyleBox["$8F",
  FontFamily->"Courier"],
 ", type ",
 StyleBox["ACCEL_ONE_HZ_TCLK",
  FontFamily->"Courier"],
 ") fires 22 \[Micro]s after each ",
 "second. Its phase before and after:"
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"idx", " ", "=", " ", 
   RowBox[{"Flatten", "@", 
    RowBox[{"Position", "[", 
