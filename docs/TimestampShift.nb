       RowBox[{"All", ",", " ", "3"}], "]"}], "]"}], "]"}], "]"}], ",", " ", 
   RowBox[{"N", "[", 
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"2", " ", 
        RowBox[{"CDF", "[", 
         RowBox[{
          RowBox[{"NormalDistribution", "[", "]"}], ",", " ", "3"}], "]"}]}], 
       " ", "-", " ", "1"}], ")"}]}], "]"}], ",", " ", 
   RowBox[{"Max", "[", 
    RowBox[{"gauss", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", " ", "3"}], "]"}], "]"}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[31]:=",ExpressionUUID->"9772dfe4-0b8b-42af-833c-f3db8880df70"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1.00325`", ",", "1.0027071046938556`", ",", "3"}], "}"}]], "Output",\

 CellChangeTimes->{4.001593469077388*^9},
 CellLabel->"Out[31]=",ExpressionUUID->"6ed6dcfa-4594-44ea-b137-d45111189ee7"]
}, Open  ]],

Cell[TextData[{
 "Mean draws per event, its expectation ",
 Cell[BoxData[
  FormBox[
   TagBox[
    FractionBox["1", 
     RowBox[{
      RowBox[{"2", " ", 
       RowBox[{"\[CapitalPhi]", "(", "3", ")"}]}], "-", "1"}]],
    HoldForm], TraditionalForm]]],
 ", and the most any event needed."
}], "Text"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["8. Determinism near rounding boundaries", "Section"],

Cell[TextData[{
 "Offsets near a half-tick are where floating point could disagree between \
machines. Search the ",
 "53-bit grid around chosen half-integers ",
 Cell[BoxData[
  FormBox[
   TagBox[
    RowBox[{
     RowBox[{"x", " ", "S"}], "\[LongEqual]", 
     RowBox[{"m", "+", 
      FractionBox["1", "2"]}]}],
    HoldForm], TraditionalForm]]],
 " for the uniforms that land closest:"
}], "Text"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"nearTie", "[", 
    RowBox[{"S_", ",", " ", "mm_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x0", " ", "=", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"mm", " ", "+", " ", 
           RowBox[{"1", "/", "2"}]}], ")"}], "/", "S"}]}], ",", " ", "k0", 
       ",", " ", "cands"}], "}"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"k0", " ", "=", " ", 
       RowBox[{"Floor", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"CDF", "[", 
           RowBox[{
            RowBox[{"NormalDistribution", "[", "]"}], ",", " ", 
            RowBox[{"N", "[", 
             RowBox[{"x0", ",", " ", "50"}], "]"}]}], "]"}], " ", 
          RowBox[{"2", "^", "53"}]}], " ", "-", " ", 
         RowBox[{"1", "/", "2"}]}], "]"}]}], ";", "\n", "   ", 
      RowBox[{"cands", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"u", " ", "=", " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"k", " ", "+", " ", 
                RowBox[{"1", "/", "2"}]}], ")"}], "/", 
              RowBox[{"2", "^", "53"}]}]}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"k", ",", " ", 
             RowBox[{"N", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"as241", "[", "u", "]"}], " ", "S"}], ",", " ", 
               "40"}], "]"}]}], "}"}]}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"k", ",", " ", 
           RowBox[{"k0", " ", "-", " ", "3"}], ",", " ", 
           RowBox[{"k0", " ", "+", " ", "3"}]}], "}"}]}], "]"}]}], ";", "\n", 
      "   ", 
      RowBox[{"First", "@", 
       RowBox[{"SortBy", "[", 
        RowBox[{"cands", ",", " ", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{"FractionalPart", "[", 
             RowBox[{"Abs", "[", 
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}], " ", "-", " ", 
            RowBox[{"1", "/", "2"}]}], "]"}], " ", "&"}]}], "]"}]}]}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ties", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"r", " ", "=", " ", 
         RowBox[{"nearTie", "[", 
          RowBox[{"1280000", ",", " ", "mm"}], "]"}]}], "}"}], ",", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<sigma\>\"", " ", "->", " ", "1280000"}], ",", " ", 
         RowBox[{"\"\<k\>\"", " ", "->", " ", 
          RowBox[{"r", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ",", "\n", "     ", 
         RowBox[{"\"\<xS\>\"", " ", "->", " ", 
          RowBox[{"ToString", "[", 
           RowBox[{"NumberForm", "[", 
            RowBox[{
             RowBox[{"r", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", " ", "30", ",", " ", 
             RowBox[{"ExponentFunction", " ", "->", " ", 
              RowBox[{"(", 
               RowBox[{"Null", " ", "&"}], ")"}]}]}], "]"}], "]"}]}], ",", 
         " ", 
         RowBox[{"\"\<distance_from_half\>\"", " ", "->", " ", 
          RowBox[{"N", "[", 
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"FractionalPart", "[", 
              RowBox[{"Abs", "[", 
               RowBox[{"r", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}], " ", "-", " ", 
             RowBox[{"1", "/", "2"}]}], "]"}], "]"}]}], ",", "\n", "     ", 
         RowBox[{"\"\<offset\>\"", " ", "->", " ", 
          RowBox[{"Round", "[", 
           RowBox[{"r", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}]}]}], "|>"}]}], "]"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"mm", ",", " ", 
       RowBox[{"{", 
        RowBox[{"12345", ",", " ", 
         RowBox[{"-", "400000"}], ",", " ", "1000000", ",", " ", 
         RowBox[{"-", "2500000"}], ",", " ", "3000000", ",", " ", "77"}], 
        "}"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"TableForm", "[", 
  RowBox[{
   RowBox[{"Values", " ", "/@", " ", "ties"}], ",", " ", 
   RowBox[{"TableHeadings", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"None", ",", " ", 
      RowBox[{"Keys", "[", 
       RowBox[{"First", "[", "ties", "]"}], "]"}]}], "}"}]}]}], 
  "]"}]}], "Input",
 CellLabel->"In[32]:=",ExpressionUUID->"3aa06d71-d0d3-4825-a6b8-069f52bbf16c"],

Cell[BoxData[
 TagBox[
  TagBox[GridBox[{
     {
      TagBox["\<\"sigma\"\>",
       HoldForm], 
      TagBox["\<\"k\"\>",
       HoldForm], 
      TagBox["\<\"xS\"\>",
       HoldForm], 
      TagBox["\<\"distance_from_half\"\>",
       HoldForm], 
      TagBox["\<\"offset\"\>",
       HoldForm]},
     {"1280000", 
