      RowBox[{"-", "399999"}]},
     {"1280000", 
      "7049686070390478", "\<\"1000000.49999999980907333613196\"\>", 
      "1.9092666386804109`*^-10", "1000000"},
     {"1280000", 
      "228804620516296", "\<\"-2499999.49999999995262166969265\"\>", 
      "4.73783303073537`*^-11", 
      RowBox[{"-", "2499999"}]},
     {"1280000", 
      "8921221290600054", "\<\"3000000.49999999871584781628149\"\>", 
      "1.2841521837185114`*^-9", "3000000"},
     {"1280000", 
      "4503817193641715", "\<\"77.5000000001629020829743627687\"\>", 
