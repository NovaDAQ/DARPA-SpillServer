# ---- DARPA spill publishing (darpa-spill-publish), novadaq-near-gateway-01 ----
# Source: DARPA-SpillServer deploy/gateway/crontab.fragment; plan section 3.
#
# MERGE, DO NOT REPLACE: this crontab also holds alec's grabSpills.sh line,
# which must stay. Either let the installer do it (backs up first, skips lines
# already present):
#     deploy/gateway/install.sh --install-cron
# or by hand:
#     crontab -l > ~/DARPA/publish/crontab.old
#     cat ~/DARPA/publish/crontab.old deploy/gateway/crontab.fragment | crontab -
#     crontab -l | grep grabSpills.sh         # must still be there
#
# cron runs these with /bin/sh; each job appends to its own log, rotated by
# logrotate.conf. No percent signs here: cron turns them into newlines.
# Times are the host's local time (America/Chicago).
#
# Credentials: renew Kerberos, refresh the FDP bearer token (before :10).
3,33 * * * * /home/novadaq/DARPA/publish/bin/run-publish.sh creds >> /data/DARPA-spilldata/publish/logs/creds.log 2>&1
# Preceding local hour (plus catch-up), after the ingest watermark check.
10 * * * * /home/novadaq/DARPA/publish/bin/run-publish.sh hourly >> /data/DARPA-spilldata/publish/logs/hourly.log 2>&1
# Preceding local day: the authoritative complete copy.
30 0 * * * /home/novadaq/DARPA/publish/bin/run-publish.sh daily >> /data/DARPA-spilldata/publish/logs/daily.log 2>&1
# Next month's shift token, ahead of time; back it up to the Mac when mailed.
0 9 25 * * /home/novadaq/DARPA/publish/bin/run-publish.sh token --next >> /data/DARPA-spilldata/publish/logs/token.log 2>&1
# Retry uploads not yet done; off the :10 hourly run.
7,22,37,52 * * * * /home/novadaq/DARPA/publish/bin/run-publish.sh upload >> /data/DARPA-spilldata/publish/logs/upload.log 2>&1
# Status page (credential ages, disk, ingest lag).
*/5 * * * * /home/novadaq/DARPA/publish/bin/run-publish.sh status -q >> /data/DARPA-spilldata/publish/logs/status.log 2>&1
# Restart darpa-spill-server if /api/health fails twice and it is not running.
*/5 * * * * /home/novadaq/DARPA/publish/bin/server-watchdog.sh >> /data/DARPA-spilldata/publish/logs/watchdog.log 2>&1
@reboot /home/novadaq/DARPA/publish/bin/server-watchdog.sh --boot-delay 90 >> /data/DARPA-spilldata/publish/logs/watchdog.log 2>&1
# Rotate run/spillserver.log and the logs above.
45 4 * * * /usr/sbin/logrotate -s /home/novadaq/DARPA/publish/logrotate.state /home/novadaq/DARPA/publish/bin/logrotate.conf >> /data/DARPA-spilldata/publish/logs/logrotate.log 2>&1
# ---- end DARPA spill publishing ----
