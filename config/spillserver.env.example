# Example .env file. Copy to ./.env (which git ignores) and edit, or point
# --env-file / DARPA_SPILL_ENV_FILE at a copy elsewhere.
#
# Order of precedence, highest first:
#     command line > environment > .env > YAML config file > defaults
# Only DARPA_SPILL_* variables are read from it; a variable already set in
# the environment keeps the environment's value.

# Server settings: DARPA_SPILL_<SECTION>_<KEY>
#DARPA_SPILL_CONFIG=config/spillserver-near.yaml
#DARPA_SPILL_SERVER_PORT=8080
#DARPA_SPILL_STORAGE_PATH=/var/lib/darpa-spillserver/spills.db
#DARPA_SPILL_ADMIN_TOKEN_FILE=/etc/darpa-spillserver/admin_token

# Client settings: DARPA_SPILL_CLIENT_<KEY>
#DARPA_SPILL_CLIENT_URL=http://novadaq-near-gateway-01.fnal.gov:8080
#DARPA_SPILL_CLIENT_FORMAT=table
#DARPA_SPILL_CLIENT_ADMIN_TOKEN_FILE=~/.config/darpa-spillserver/admin_token
